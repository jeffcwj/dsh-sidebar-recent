{
  "name": "@local/dsh-sidebar-recent",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Web sidebar: a compact collapsible \"Recently\" section above the workspace groups",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "sessions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffcwj/dsh-sidebar-recent.git"
  },
  "homepage": "https://github.com/jeffcwj/dsh-sidebar-recent#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
